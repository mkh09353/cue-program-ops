# CUE local development uses in-memory lifecycle + schedule stores, a mock
# Accelevents client, MockMailer, and MemorySnapshotPersistence by default.
# No credentials are required for the credential-free demo (zero external network).

# Optional Node API port (default 8787). Vite proxies /api,/public,/sync here.
PORT=8787

# --- Accelevents one-way sync (OFF by default) ---
# HTTP client is selected ONLY when ALL four are set and LIVE=true.
# Endpoint paths and field names in src/accelevents.ts + src/mapping.ts are
# PLACEHOLDERS until Accelevents confirms the production API contract.
# Do not enable LIVE without that confirmation.
ACCELEVENTS_LIVE=false
ACCELEVENTS_BASE_URL=https://api.example.accelevents.invalid
ACCELEVENTS_EVENT_ID=remote-event-id
ACCELEVENTS_TOKEN=replace-me

# --- Optional Airtable event snapshot (OFF by default) ---
# When BOTH are set, configuredPersistence selects AirtableSnapshotPersistence
# (src/persistence.ts + AirtableTransport). Startup restoreSnapshot() may reload
# the last CompetitionSnapshot; mutating API paths best-effort save.
# Table: "CUE Snapshots" — see AIRTABLE_SNAPSHOT_SCHEMA in src/persistence.ts.
# This is a single-record JSON snapshot for demo continuity, NOT multi-writer
# production durability and NOT a normalized entity Repository.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# --- Optional Resend-compatible mail (OFF by default) ---
# When BOTH are set, configuredMailer selects HttpMailer → https://api.resend.com/emails.
# Otherwise MockMailer records messages in-process with status mock_sent (zero network).
# ICS invites attach as text/calendar when a scheduled session exists.
MAILER_API_KEY=
MAILER_FROM=

# File binary storage and external LLMs are not wired: uploads store filename
# receipts only; AI assist is deterministic in-process. See README "Mock vs configured".
